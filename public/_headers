/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The document (index.html is served at every SPA route via the /* fallback)
  # must always revalidate — otherwise a tab can hold a stale index that points
  # at chunk hashes a newer deploy replaced, which then fall back to index.html
  # and break the dynamic import with a "text/html" MIME error.
  Cache-Control: no-cache

# Hashed build assets are content-addressed, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/functions/v1/social-share
  Content-Type: text/html; charset=utf-8
/functions/v1/social-share/*
  Content-Type: text/html; charset=utf-8
